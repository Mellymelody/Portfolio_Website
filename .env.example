# Netlify Environment Variables (set in Netlify Dashboard > Site Settings > Environment Variables)
# Get these after creating accounts:

# Supabase (Database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-from-supabase

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Who receives contact form mail (defaults to princelouis558@gmail.com)
CONTACT_TO_EMAIL=princelouis558@gmail.com
# Must be a sender verified in Resend for production delivery.
# The default onboarding@resend.dev only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>